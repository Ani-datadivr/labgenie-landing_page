# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed. Restart `npm run dev` after editing.
#
# The site builds and runs WITHOUT these (the API routes degrade gracefully).
# You only need them for the two live features below.

# --- Gemini chat (the "Ask LabGenie" chat inside the Operations Dashboard) ---
# Get a key at https://aistudio.google.com/apikey  (real keys start with "AIzaSy...").
GEMINI_API_KEY=

# Optional model override. Defaults to "gemini-2.5-flash-lite" inside the route.
GEMINI_MODEL=gemini-2.5-flash

# --- Slack lead delivery (the /contact request-demo form) ---
# Create an incoming webhook at https://api.slack.com/messaging/webhooks
# Server-side only; never exposed to the browser.
SLACK_WEBHOOK_URL=

# --- Keystatic CMS in GitHub mode (so /keystatic editing works on the live site) ---
# Storage is GitHub automatically on Vercel; local files in dev.
# KEYSTATIC_SECRET is a random signing secret you set yourself:  openssl rand -hex 32
# The CLIENT_ID / CLIENT_SECRET / APP_SLUG are minted by the "Create GitHub App"
# wizard the first time you open /keystatic on the deployed site (see DEPLOY.md §3).
KEYSTATIC_SECRET=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# --- Editor "Preview" button (draft → preview → publish) ---
# The URL of the `staging`-branch Vercel preview deploy. Keystatic shows a
# "Preview" link on every editing screen pointing here, so editors see the full
# site with their pending (unpublished) changes before merging staging → main.
# {branch} and {slug} are filled in by Keystatic. Find your exact host in
# Vercel → Deployments (the *-git-staging-*.vercel.app URL). See DEPLOY.md §3.
NEXT_PUBLIC_KEYSTATIC_PREVIEW_URL=https://labgenie-landing-page-git-{branch}-ani-datadivr.vercel.app/{slug}
