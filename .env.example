# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed. Restart `npm run dev` after editing.
#
# The site builds and runs WITHOUT these (the API routes degrade gracefully).
# You only need them for the two live features below.

# --- Gemini chat (the "Ask LabGenie" chat inside the Operations Dashboard) ---
# Get a key at https://aistudio.google.com/apikey  (real keys start with "AIzaSy...").
GEMINI_API_KEY=

# Optional model override. Defaults to "gemini-2.5-flash-lite" inside the route.
GEMINI_MODEL=gemini-2.5-flash

# --- Slack lead delivery (the /contact request-demo form) ---
# Create an incoming webhook at https://api.slack.com/messaging/webhooks
# Server-side only; never exposed to the browser.
SLACK_WEBHOOK_URL=

# --- Keystatic CMS in Cloud mode (so /keystatic editing works on the live site) ---
# Editors are invited by email at https://keystatic.cloud — no GitHub account needed.
# Leave this UNSET locally → /keystatic runs in local-file mode (zero setup, writes
# JSON straight to src/content/). Set it ONLY in Vercel (Production + Preview) to the
# "team/project" slug from your Keystatic Cloud dashboard. See DEPLOY.md.
# Example:  NEXT_PUBLIC_KEYSTATIC_CLOUD_PROJECT=labgenie/landing-page
NEXT_PUBLIC_KEYSTATIC_CLOUD_PROJECT=
